# MoeNet Core Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# Database
# =============================================================================
DB_PASSWORD=your_secure_password_here

# =============================================================================
# Authentication
# =============================================================================
JWT_SECRET=your_jwt_secret_here
AGENT_API_KEY=your_agent_api_key_here
API_TOKEN=your_api_token_here

# =============================================================================
# Telegram Bot
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_USERNAME=your_telegram_username
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id
TELEGRAM_CONTACT=@heicha
LOCAL_ASN=4242420998

# Peer approval: false (default) = ALL peer requests go to manual review.
# Set true to enable lenient auto-approve (all-green requests skip review; hard
# blockers — unowned ULA/GUA IP, bogus/CN endpoint — still escalate to review).
# PEER_AUTO_APPROVE=false

# Webhook (required for production)
WEBHOOK_DOMAIN=bot.example.com
WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_PORT=8443

# MTProto Username Resolver (optional)
# Enables resolving @username → TG ID for users who never interacted with the bot.
# Get these from https://my.telegram.org → API development tools
# If not set, falls back to Redis cache only (existing behavior).
# TG_API_ID=12345678
# TG_API_HASH=your_api_hash_here

# Redis session persistence (optional, uses in-memory if not set)
# REDIS_URL=redis://moenet-redis:6379

# Rate limiting (optional)
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# Agent Configuration (for distributed tools; agent hosts come from the DB)
# =============================================================================
AGENT_PORT=8080
AGENT_TOKEN=your_agent_token

# =============================================================================
# Email Service (Mailgun)
# =============================================================================
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=dn42.moenet.work
MAILGUN_FROM=DN42 Bot <bot@dn42.moenet.work>

# =============================================================================
# Control Plane / Bootstrap
# =============================================================================
CORE_URL=https://api.moenet.work

# API server bind host (optional; default 0.0.0.0, required inside containers)
# HOST=0.0.0.0

# Agent auto-update: set false to stop the control plane telling agents to
# self-update to the latest stable release (optional; default enabled).
# AGENT_AUTOUPDATE=true

# Binary download URLs (optional, defaults to GitHub releases)
# AGENT_DOWNLOAD_URL=https://github.com/heichaowo/moenet-agent/releases/latest/download/moenet-agent-linux-amd64
# BIRD_DOWNLOAD_URL=https://github.com/heichaowo/dn42-binaries/releases/latest/download/bird
# BIRDC_DOWNLOAD_URL=https://github.com/heichaowo/dn42-binaries/releases/latest/download/birdc

# =============================================================================
# Monitoring (Grafana/Prometheus)
# =============================================================================
# Grafana admin password (username: admin).
# Required: grafana.moenet.work is a public router and Grafana's built-in
# default is admin/admin. `docker compose up` fails loudly if this is unset or
# empty.
#
# Keep the value alone on its line. Compose strips an inline ` # comment` from
# an unquoted value, so `GRAFANA_PASSWORD=  # note` parses as EMPTY.
#
# Only applied when Grafana first creates its admin user (fresh grafana_data
# volume). To rotate on a running deployment:
#     docker compose exec grafana grafana-cli admin reset-admin-password '<pw>'
GRAFANA_PASSWORD=replace-me-with-a-strong-password

# Prometheus basic-auth, consumed by the traefik `prom-auth` middleware.
# Required: prom.moenet.work is a public router and Prometheus has no auth of
# its own. `docker compose up` fails loudly if this is unset or empty.
#
# Generate:  openssl passwd -apr1 '<password>'   then prefix with the username:
#     PROM_BASICAUTH='admin:$apr1$SALT$HASH'
#
# QUOTING - read before editing:
#   * MUST be single-quoted. Compose interpolates unquoted and double-quoted
#     .env values, so a bare $apr1$... would be eaten as variable references
#     and silently collapse to an empty string.
#   * Use SINGLE dollar signs here. Doubling them ($$apr1$$...) is only correct
#     for a hash written inline in compose YAML; inside single-quoted .env the
#     $$ would be taken literally and the hash would never match.
PROM_BASICAUTH='admin:$apr1$replace$mewithagenerated'
