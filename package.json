{
  "name": "moenet-core",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --filter @moenet/api dev",
    "dev:web": "bun run --filter @moenet/web dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "bun run --filter '*' build",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "contract:lint": "bunx @redocly/cli lint contract/agent-api.openapi.yaml contract/cp-agent-api.openapi.yaml",
    "contract:gen": "bunx openapi-typescript contract/cp-agent-api.openapi.yaml -o packages/api/src/generated/cp-agent-api.d.ts && bunx openapi-typescript contract/agent-api.openapi.yaml -o packages/bot/src/generated/agent-api.d.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}